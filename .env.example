# Copy to .env and fill in ONE of these (https://www.themoviedb.org/settings/api).
# .env is git-ignored; never commit real credentials.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Which catalogue the app serves: "tmdb" (default when backend/data/tmdb_movies.json exists) or "curated".
# CINEMAGIC_DATASET=tmdb
