# Copy to .env and fill in ONE of these (https://www.themoviedb.org/settings/api).
# .env is git-ignored; never commit real credentials.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Which catalogue the app serves: "tmdb" (default when backend/data/tmdb_movies.json exists) or "curated".
# CINEMAGIC_DATASET=tmdb

# Optional live-search cache path (default: backend/data/catalogue.sqlite3)
# CINEMAGIC_CACHE_PATH=backend/data/catalogue.sqlite3

# S6 operational settings: set in your shell/hosting environment (not this .env).
# Unset enables all; an explicitly empty value disables movie playback.
# CINEMAGIC_PROVIDERS=cinesrc,vidlink,vidsrc
# CINEMAGIC_RANKING=snapshot  # Roll back dynamic ranking; default is dynamic.

# S7: Render prompts for TMDB_READ_ACCESS_TOKEN privately through render.yaml.
# Set hosting variables in Render, never upload this private .env file.
# The Free service uses CINEMAGIC_CACHE_PATH=/tmp/cinemagic/catalogue.sqlite3.
